# SERVER
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# SUPABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# SUPABASE STORAGE BUCKET
SUPABASE_DOCUMENT_BUCKET=documents
SUPABASE_SCRIPT_BUCKET=generated-scripts

# AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

AI_MAX_USAGE_PER_WINDOW=3
AI_COOLDOWN_SECONDS=180


AI_QUEUE_CONCURRENCY=4
AI_QUEUE_MAX_WAITING=80
AI_QUEUE_JOB_TIMEOUT_MS=20000
AI_GEMINI_TIMEOUT_MS=20000

AI_RESPONSE_CACHE_ENABLED=true
AI_RESPONSE_CACHE_TTL_SECONDS=86400

# CORS
ALLOWED_ORIGIN=http://localhost:4321,http://localhost:3000
FRONTEND_URL=http://localhost:4321

# WIDGET
DEFAULT_WIDGET_MODE=floating
DEFAULT_WIDGET_POSITION=bottom-right
