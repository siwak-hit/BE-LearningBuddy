# SERVER
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# SUPABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# SUPABASE STORAGE BUCKET
SUPABASE_DOCUMENT_BUCKET=documents
SUPABASE_SCRIPT_BUCKET=generated-scripts

# AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

AI_MAX_USAGE_PER_WINDOW=3
AI_COOLDOWN_SECONDS=180

# TIMEOUT
CHAT_REQUEST_TIMEOUT_MS=20000
AI_REQUEST_TIMEOUT_MS=18000
MOODLE_REQUEST_TIMEOUT_MS=18000
PUBLIC_API_TIMEOUT_MS=20000

# CACHE
MOODLE_CONFIG_CACHE_TTL_MS=300000
AI_RESPONSE_CACHE_ENABLED=true
AI_RESPONSE_CACHE_TTL_SECONDS=86400


# AI QUEUE
AI_QUEUE_CONCURRENCY=4
AI_QUEUE_MAX_SIZE=120
AI_QUEUE_TIMEOUT_MS=20000
AI_GEMINI_TIMEOUT_MS=20000

AI_RESPONSE_CACHE_ENABLED=true
AI_RESPONSE_CACHE_TTL_SECONDS=86400

# CORS
ALLOWED_ORIGIN=http://localhost:2468,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://192.168.1.5:5500,http://localhost,http://localhost:80,https://fe-learning-buddy-bca7kkw6b-siwak-hits-projects.vercel.app
FRONTEND_URL=https://fe-learning-buddy-b0h56pyeh-siwak-hits-projects.vercel.app/

# WIDGET
DEFAULT_WIDGET_MODE=floating
DEFAULT_WIDGET_POSITION=bottom-right
