# SERVER
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# SUPABASE
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# SUPABASE STORAGE BUCKET
SUPABASE_DOCUMENT_BUCKET=documents
SUPABASE_SCRIPT_BUCKET=generated-scripts

# AI
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

AI_MAX_USAGE_PER_WINDOW=3
AI_COOLDOWN_SECONDS=180

# TIMEOUT
CHAT_REQUEST_TIMEOUT_MS=20000
AI_REQUEST_TIMEOUT_MS=18000
MOODLE_REQUEST_TIMEOUT_MS=18000
PUBLIC_API_TIMEOUT_MS=20000

# CACHE
MOODLE_CONFIG_CACHE_TTL_MS=300000
AI_RESPONSE_CACHE_ENABLED=true
AI_RESPONSE_CACHE_TTL_SECONDS=86400


# AI QUEUE
AI_QUEUE_CONCURRENCY=4
AI_QUEUE_MAX_SIZE=120
AI_QUEUE_TIMEOUT_MS=20000
AI_GEMINI_TIMEOUT_MS=20000

AI_RESPONSE_CACHE_ENABLED=true
AI_RESPONSE_CACHE_TTL_SECONDS=86400

# CORS
ALLOWED_ORIGIN=http://localhost:2468,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://192.168.1.5:5500,http://localhost,http://localhost:80,https://fe-learning-buddy-bca7kkw6b-siwak-hits-projects.vercel.app
FRONTEND_URL=https://fe-learning-buddy-b0h56pyeh-siwak-hits-projects.vercel.app/

# WIDGET
DEFAULT_WIDGET_MODE=floating
DEFAULT_WIDGET_POSITION=bottom-right

# AUTH — Kode registrasi rahasia untuk form Daftar guru.
# Kosongkan/hapus untuk MENONAKTIFKAN pendaftaran (endpoint /auth/register balas 403).
# Isi dengan kode rahasia agar hanya yang tahu kode bisa membuat akun admin.
REGISTER_CODE=smpn167jkt

# MOODLE — TTL cache health check "mode darurat" (ms). Default 300000 (5 menit).
# MOODLE_HEALTH_TTL_MS=300000

# KUOTA AI BERSAMA (per jam) — jumlah jawaban AI (gabungan semua siswa) yang bikin 100%/penuh.
# Persentase naik tiap jawaban AI & tidak turun; reset otomatis 1 jam setelah pemakaian pertama.
AI_HOURLY_GLOBAL_BUDGET=30
# AI_GLOBAL_WINDOW_MS=3600000  # panjang jendela (default 1 jam)
